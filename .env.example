# Copy this file to .env.local and fill in real values. See SETUP.md for where
# each value comes from. Never commit .env.local.

# --- Supabase --------------------------------------------------------------
# Supabase Dashboard → Project Settings → Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Project Settings → API Keys → service_role (SECRET — server only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Razorpay -------------------------------------------------------------
# Razorpay Dashboard → Settings → API Keys (use Test Mode keys to start)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Razorpay Dashboard → Settings → Webhooks → the secret you set when creating the webhook
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# --- Resend (order confirmation emails) ---------------------------------
# https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# A verified sender. For quick testing you can use: shoe-vault <onboarding@resend.dev>
EMAIL_FROM=shoe-vault <onboarding@resend.dev>

# --- App ---------------------------------------------------------------
# No trailing slash. Use http://localhost:3000 for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
